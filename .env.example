# Waste2Value Environment Configuration Template
# Copy this file to .env for backend, or frontend/.env.local for frontend development.

# ==============================================================================
# 1. APPLICATION ENVIRONMENT
# ==============================================================================
ENVIRONMENT=development
STAGE=dev
DEBUG=true

# ==============================================================================
# 2. BACKEND API SETTINGS
# ==============================================================================
API_V1_PREFIX=/api
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./waste2value.db

# ==============================================================================
# 3. AWS SERVICES CONFIGURATION (Optional for local development)
# Leave blank to run with local simulated providers (Demo Mode).
# When deploying to AWS, these variables are injected automatically by SAM.
# ==============================================================================
AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=default

# DynamoDB Table Name for Single-Table persistence
REGISTRY_TABLE=w2v-registry-dev

# S3 Bucket for Private Evidence Dossiers
EVIDENCE_BUCKET=w2v-evidence-dev-example

# AWS KMS RSA-4096 Key ARN for Asymmetric Passport Signing
KMS_KEY_ARN=arn:aws:kms:eu-central-1:123456789012:key/example-rsa-4096-key

# Amazon Bedrock Foundation Model
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ==============================================================================
# 4. FRONTEND CONFIGURATION (frontend/.env.local)
# ==============================================================================
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_APP_ENV=local
